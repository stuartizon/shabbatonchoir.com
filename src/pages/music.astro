---
import { getCollection } from 'astro:content';
import Album from '../components/Album.astro';
import Layout from '../layouts/Layout.astro';

const albums = (await getCollection('albums')).sort(
  (a, b) => b.data.year - a.data.year,
);
---

<Layout
  title="Music"
  description="Listen to albums by the Shabbaton Choir, from Anim Z'mirot to Selichot Live, on Spotify, Apple Music and Amazon Music: modern Jewish choral music for prayer."
>
  <div class="flex flex-wrap justify-evenly md:justify-between gap-x-4">
    {albums.map(({ data }) => (
      <Album {...data} />
    ))}
  </div>
</Layout>
