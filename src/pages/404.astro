---
// Cloudflare Pages serves this, with a 404 status, for any unknown path.
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page not found"
  description="Sorry, we couldn't find that page on the Shabbaton Choir website."
  noindex
>
  <p>
    Sorry, we couldn't find that page. The link may be out of date, or the page
    may have moved.
  </p>
  <p>Try one of these instead:</p>
  <ul class="-mt-4 mb-16 list-disc pl-6">
    <li>
      <a class="inline-block py-2" href="/">
        Home
      </a>
    </li>
    <li>
      <a class="inline-block py-2" href="/music">
        Music
      </a>
    </li>
    <li>
      <a class="inline-block py-2" href="/contact">
        Contact
      </a>
    </li>
  </ul>
</Layout>
