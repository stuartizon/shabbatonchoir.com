---
import Icon from '../components/Icon.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact"
  description="Get in touch with the Shabbaton Choir. Email us at info@shabbatonchoir.com or message us on Facebook Messenger."
>
  To contact us, please:
  <div class="flex flex-col md:flex-row mt-4 mb-16 justify-evenly gap-4">
    <div class="shadow-md p-6 text-center">
      <div class="flex items-center justify-center gap-2 m-4">
        <Icon size="2x" name="envelope" /> EMAIL US
      </div>
      <a href="mailto:info@shabbatonchoir.com" target="_blank" rel="noreferrer">
        info@shabbatonchoir.com
      </a>
    </div>
    <div class="shadow-md p-6 text-center">
      <div class="flex items-center justify-center gap-2 m-4">
        <Icon size="2x" name="chat" /> MESSAGE US
      </div>
      via{' '}
      <a href="https://m.me/shabbatonchoir" target="_blank" rel="noreferrer">
        Facebook messenger
      </a>
    </div>
  </div>
</Layout>
