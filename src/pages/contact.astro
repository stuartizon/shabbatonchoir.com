---
import Icon from '../components/Icon.astro';
import { SOCIAL_LINKS } from '../components/social';
import Layout from '../layouts/Layout.astro';

// Each kind of enquiry, with the role address that handles it.
const EMAIL_OPTIONS = [
  {
    heading: 'Join the choir',
    text: [
      'If you are interested in joining the Shabbaton Choir as a chorister, please contact our Musical Director, Harry Style.',
      'We rehearse on most Tuesday evenings.',
    ],
    address: 'md@shabbatonchoir.com',
  },
  {
    heading: 'Mailing list and bookings',
    text: [
      'If you would like to be added to our mailing list or to engage us for a concert or choral Shabbaton, please contact our Chairman, Russell Kett.',
    ],
    address: 'chairman@shabbatonchoir.com',
  },
];

const FOLLOW_TEXT: Record<string, string> = {
  Facebook: 'Become a fan of the Shabbaton Choir on Facebook',
  X: 'Follow the Shabbaton Choir on X',
};
const FOLLOW_LINKS = SOCIAL_LINKS.filter(
  ({ service }) => service in FOLLOW_TEXT,
);
---

<Layout
  title="Contact"
  description="Contact the Shabbaton Choir to join as a chorister, join our mailing list or book us for a concert or choral Shabbaton."
>
  <ul class="mb-12 flex flex-col gap-4">
    {EMAIL_OPTIONS.map(({ heading, text, address }) => (
      // The email link's ::after covers the whole card, so the card can be
      // tapped anywhere while the link keeps a short accessible name.
      // Hovering anywhere on the card fades the button, as links do.
      <li class="relative rounded-lg border border-gray-200 bg-white p-4 min-[375px]:p-5 sm:p-6">
        <h2 class="mt-0 mb-2 text-xl">{heading}</h2>
        {text.map((line) => (
          <p class="my-2">{line}</p>
        ))}
        <a
          href={`mailto:${address}`}
          class="mt-4 flex min-h-11 w-full items-center justify-center gap-2 rounded-md bg-primary-500 px-3 py-2 text-base font-medium sm:px-4 sm:text-lg text-white no-underline after:absolute after:inset-0 after:rounded-lg after:content-[''] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500 sm:inline-flex sm:w-auto"
        >
          <Icon name="envelope" class="shrink-0 text-xl" />
          <span class="min-w-0 [overflow-wrap:anywhere]">
            <span class="sr-only">Email </span>
            {/* If an address has to wrap on a narrow phone, wrap it after the @. */}
            {address.split('@')[0]}@<wbr />
            {address.split('@')[1]}
          </span>
        </a>
      </li>
    ))}
  </ul>

  <h2 class="mb-4 text-xl">Follow us</h2>
  <ul class="mb-16 flex flex-col gap-2">
    {FOLLOW_LINKS.map(({ service, name, href }) => (
      <li>
        <a
          href={href}
          target="_blank"
          rel="noreferrer"
          class="-mx-2 flex min-h-11 items-start gap-3 rounded-md px-2 py-2 decoration-1 focus-visible:outline-2 focus-visible:outline-primary-500"
        >
          {/* As tall as one line of text, so the icon centres on the first
          line when the text wraps. */}
          <span class="flex h-[1lh] shrink-0 items-center">
            <Icon name={name} class="text-xl text-gray-600" />
          </span>
          {FOLLOW_TEXT[service]}
        </a>
      </li>
    ))}
  </ul>
</Layout>
