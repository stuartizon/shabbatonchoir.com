---
import { getImage } from 'astro:assets';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import HeaderDesktop from '../components/HeaderDesktop.astro';
import HeaderMobile from '../components/HeaderMobile.astro';
import { HERO_SIZES, HERO_WIDTHS, heroImage } from '../components/hero';
import { toJsonLd } from '../structured-data';

interface Props {
  /**
   * The page's name, shown as its heading and in its <title>. Without one,
   * the page is titled "Shabbaton Choir" and its heading is visually hidden.
   */
  title?: string;
  /** What search results show under the title: 140 to 160 characters. */
  description: string;
  /**
   * Keep the page out of search results, and give it no canonical address,
   * as for the 404 page.
   */
  noindex?: boolean;
  /** JSON-LD describing the page's content to search engines. */
  structuredData?: Record<string, unknown>[];
  /**
   * The page lays out its own heading and sections, full width. Otherwise
   * it's a single column of text under the page's title.
   */
  wide?: boolean;
  /** Cream behind the whole page, for pages that are mostly cards. */
  cream?: boolean;
}

const {
  title,
  description,
  noindex = false,
  structuredData,
  wide = false,
  cream = false,
} = Astro.props;
// The home page has no name of its own, so it is just the choir's name.
const pageTitle = title ? `${title} · Shabbaton Choir` : 'Shabbaton Choir';
// Point search engines at the live site, with the clean URLs the site uses
// (/music, not /music.html).
const canonical = new URL(
  Astro.url.pathname.replace(/(index)?\.html$/, ''),
  Astro.site,
);
// The picture WhatsApp, Facebook and X show when a page is shared.
const shareImage = new URL('/share.jpg', Astro.site);
// With build.format 'file', the home page builds as /index.html.
const isHome = /^\/(index\.html)?$/.test(Astro.url.pathname);
// Preload the hero, the largest thing on the home page, in the format most
// browsers pick. The options match the hero's AVIF source, so the URLs do too.
const heroPreload =
  isHome &&
  (await getImage({
    src: heroImage,
    width: 2000,
    widths: HERO_WIDTHS,
    format: 'avif',
    quality: 'high',
  }));
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <link rel="canonical" href={canonical} />
    )}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Shabbaton Choir" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {heroPreload && (
      <link
        rel="preload"
        as="image"
        type="image/avif"
        imagesrcset={heroPreload.srcSet.attribute}
        imagesizes={HERO_SIZES}
        fetchpriority="high"
      />
    )}
    {structuredData && (
      <script
        is:inline
        type="application/ld+json"
        set:html={toJsonLd(structuredData)}
      />
    )}
  </head>
  <body>
    <!-- At least as tall as the window, so on short pages the footer sits at
    the bottom of the screen. dvh follows phone browsers' toolbars. -->
    <div class:list={['flex min-h-dvh flex-col', cream && 'bg-cream']}>
      <HeaderDesktop />
      <HeaderMobile />
      <main class="flex-1">
        {wide ? (
          <slot />
        ) : (
          <div class="mx-auto max-w-prose px-4 pb-16 text-lg leading-relaxed">
            <h1 class:list={['mt-10 md:mt-14', !title && 'sr-only']}>
              {title ?? 'Shabbaton Choir'}
            </h1>
            <slot />
          </div>
        )}
      </main>
      <Footer />
    </div>
  </body>
</html>
