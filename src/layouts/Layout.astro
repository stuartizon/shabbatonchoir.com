---
import { getImage } from 'astro:assets';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import HeaderDesktop from '../components/HeaderDesktop.astro';
import HeaderMobile from '../components/HeaderMobile.astro';
import Hero from '../components/Hero.astro';
import { HERO_SIZES, HERO_WIDTHS, heroImage } from '../components/hero';
import Navigation from '../components/Navigation.astro';

interface Props {
  title?: string;
}

const { title } = Astro.props;
// With build.format 'file', the home page builds as /index.html.
const isHome = /^\/(index\.html)?$/.test(Astro.url.pathname);
// Preload the hero, the largest thing on the home page, in the format most
// browsers pick. The options match the hero's AVIF source, so the URLs do too.
const heroPreload =
  isHome &&
  (await getImage({
    src: heroImage,
    width: 2000,
    widths: HERO_WIDTHS,
    format: 'avif',
    quality: 'high',
  }));
---

<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Shabbaton Choir</title>
    <link rel="icon" type="image/x-icon" href="/favicon.png" />
    {heroPreload && (
      <link
        rel="preload"
        as="image"
        type="image/avif"
        imagesrcset={heroPreload.srcSet.attribute}
        imagesizes={HERO_SIZES}
        fetchpriority="high"
      />
    )}
  </head>
  <body>
    <div>
      {isHome ? (
        <Hero mode="desktop">
          <HeaderDesktop />
        </Hero>
      ) : (
        <HeaderDesktop />
      )}
      <HeaderMobile />
      <div class="overflow-hidden">
        <Navigation />
        {isHome && <Hero mode="mobile" />}
        <main>
          <div class="mx-auto px-4 max-w-prose text-gray-600 text-lg">
            <h1>{title}</h1>
            <slot />
          </div>
        </main>
      </div>
      <Footer />
    </div>
  </body>
</html>
