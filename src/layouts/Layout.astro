---
import { getImage } from 'astro:assets';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import HeaderDesktop from '../components/HeaderDesktop.astro';
import HeaderMobile from '../components/HeaderMobile.astro';
import Hero from '../components/Hero.astro';
import { HERO_SIZES, HERO_WIDTHS, heroImage } from '../components/hero';
import Navigation from '../components/Navigation.astro';

interface Props {
  /** The page's name, shown as its heading and in its <title>. */
  title?: string;
  /** What search results show under the title: 140 to 160 characters. */
  description: string;
}

const { title, description } = Astro.props;
// The home page has no name of its own, so it gets the choir's name and a
// tagline instead.
const pageTitle = title
  ? `${title} · Shabbaton Choir`
  : 'Shabbaton Choir · Jewish choral music from London';
// Point search engines at the live site, with the clean URLs the site uses
// (/music, not /music.html).
const canonical = new URL(
  Astro.url.pathname.replace(/(index)?\.html$/, ''),
  Astro.site,
);
// With build.format 'file', the home page builds as /index.html.
const isHome = /^\/(index\.html)?$/.test(Astro.url.pathname);
// Preload the hero, the largest thing on the home page, in the format most
// browsers pick. The options match the hero's AVIF source, so the URLs do too.
const heroPreload =
  isHome &&
  (await getImage({
    src: heroImage,
    width: 2000,
    widths: HERO_WIDTHS,
    format: 'avif',
    quality: 'high',
  }));
---

<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {heroPreload && (
      <link
        rel="preload"
        as="image"
        type="image/avif"
        imagesrcset={heroPreload.srcSet.attribute}
        imagesizes={HERO_SIZES}
        fetchpriority="high"
      />
    )}
  </head>
  <body>
    <div>
      {isHome ? (
        <Hero mode="desktop">
          <HeaderDesktop />
        </Hero>
      ) : (
        <HeaderDesktop />
      )}
      <HeaderMobile />
      <div class="overflow-hidden">
        <Navigation />
        {isHome && <Hero mode="mobile" />}
        <main>
          <div class="mx-auto px-4 max-w-prose text-gray-600 text-lg">
            <h1>{title}</h1>
            <slot />
          </div>
        </main>
      </div>
      <Footer />
    </div>
  </body>
</html>
