---
import '@fortawesome/fontawesome-svg-core/styles.css';
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import HeaderDesktop from '../components/HeaderDesktop.astro';
import HeaderMobile from '../components/HeaderMobile.astro';
import Hero from '../components/Hero.astro';
import Navigation from '../components/Navigation.astro';

interface Props {
  title?: string;
}

const { title } = Astro.props;
// With build.format 'file', the home page builds as /index.html.
const isHome = /^\/(index\.html)?$/.test(Astro.url.pathname);
---

<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Shabbaton Choir</title>
    <link rel="icon" type="image/x-icon" href="/favicon.png" />
  </head>
  <body>
    <div>
      {isHome ? <Hero mode="desktop"><HeaderDesktop /></Hero> : <HeaderDesktop />}
      <HeaderMobile />
      <div class="overflow-hidden">
        <Navigation />
        {isHome && <Hero mode="mobile" />}
        <main>
          <div class="mx-auto px-4 max-w-prose text-gray-600 text-lg">
            <h1>{title}</h1>
            <slot />
          </div>
        </main>
      </div>
      <Footer />
    </div>
  </body>
</html>
