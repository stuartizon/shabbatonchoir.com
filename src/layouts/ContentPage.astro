---
// A page whose text comes from a Markdown file in src/content/pages.
import { getEntry, render } from 'astro:content';
import Layout from './Layout.astro';

interface Props {
  /** The Markdown file's name, without .md. */
  id: string;
}

const { id } = Astro.props;
const page = await getEntry('pages', id);
if (!page) throw new Error(`No page text in src/content/pages/${id}.md`);
const { Content } = await render(page);
---

<Layout title={page.data.title} description={page.data.description}>
  <div
    class:list={[
      // Photos in the text, such as a portrait beside a bio: full width on
      // phones, and beside the text from tablet width up. Each heading
      // starts below any photo before it.
      '[&_img]:rounded-lg [&_h2]:clear-both',
      'sm:[&_img]:float-right sm:[&_img]:w-60 sm:[&_img]:ml-6 sm:[&_img]:mb-4',
    ]}
  >
    <Content />
  </div>
</Layout>
