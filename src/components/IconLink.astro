---
// A link that shows only an icon, opening in a new tab. The label is its
// accessible name, since the icon itself is hidden from screen readers.
// Pass padding in class to make the tap target at least 44×44px.
import type { IconName } from '../icons';
import Icon from './Icon.astro';

interface Props {
  href: string;
  label: string;
  name: IconName;
  size?: '2x';
  class?: string;
}

const { href, label, name, size, class: className } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noreferrer"
  aria-label={label}
  class:list={[
    'flex rounded focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary-500',
    className,
  ]}
>
  <Icon size={size} class="text-gray-600" name={name} />
</a>
