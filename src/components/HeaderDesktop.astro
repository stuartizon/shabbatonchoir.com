---
import Logo from './Logo.astro';
import { NAV_LINKS, isCurrent } from './nav';
---

<header class="hidden md:block">
  <div class="hidden md:flex container px-10 pt-4 mx-auto justify-between items-center">
    <Logo />
    <div class="flex space-y-4 px-2 py-6 uppercase text-center md:static md:flex-row md:space-x-10 md:space-y-0 md:border-0 md:w-fit">
      {NAV_LINKS.map(({ href, label }) => (
        <a
          class="text-sm font-medium"
          href={href}
          aria-current={
            isCurrent(href, Astro.url.pathname) ? 'page' : undefined
          }
        >
          {label}
        </a>
      ))}
    </div>
  </div>
</header>
