---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

type Props = CollectionEntry<'albums'>['data'];

const { name, description, year, cover, spotify, apple, amazon } = Astro.props;
---

<div class="bg-white rounded-lg overflow-hidden w-80 mb-8">
  <div class="h-full w-full bg-gray-50 rounded-b-lg">
    <img src={cover.src} alt={name} class="w-full max-h-72" />
    <div class="p-4">
      <div class="flex items-center justify-between">
        <div class="font-semibold text-xs">{year}</div>
        <div class="flex -my-[13px] -mr-[13px]">
          <a
            href={spotify}
            target="_blank"
            rel="noreferrer"
            aria-label={`Listen to ${name} on Spotify`}
            class="flex p-[13px] rounded focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary-500"
          >
            <Icon class="text-gray-600" name="spotify" />
          </a>
          <a
            href={apple}
            target="_blank"
            rel="noreferrer"
            aria-label={`Listen to ${name} on Apple Music`}
            class="flex p-[13px] rounded focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary-500"
          >
            <Icon class="text-gray-600" name="apple-music" />
          </a>
          <a
            href={amazon}
            target="_blank"
            rel="noreferrer"
            aria-label={`Listen to ${name} on Amazon Music`}
            class="flex p-[13px] rounded focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary-500"
          >
            <Icon class="text-gray-600" name="amazon" />
          </a>
        </div>
      </div>
      <h2 class="font-bold my-4">{name}</h2>
      <p class="text-sm my-2">{description}</p>
    </div>
  </div>
</div>
