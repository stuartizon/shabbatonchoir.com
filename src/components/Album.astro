---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { splitHebrew } from '../hebrew';
import ListenLinks from './ListenLinks.astro';

type Props = CollectionEntry<'albums'>['data'];

const { name, hebrewName, description, year, cover } = Astro.props;
---

<article class="flex flex-col gap-3.5">
  <Picture
    src={cover}
    alt={name}
    width={720}
    widths={[360, 720]}
    sizes="(min-width: 768px) 360px, calc(100vw - 32px)"
    formats={['avif', 'webp']}
    class="aspect-square w-full rounded-2xl object-cover shadow-[0_16px_32px_-18px_rgb(15_33_96/0.45)]"
  />
  <p
    data-year
    class="mt-1.5 mb-0 text-[0.8125rem] font-bold tracking-[0.14em] text-gold-ink uppercase"
  >
    {year}
  </p>
  <!-- English on the left, Hebrew on the right, on one line where they fit. -->
  <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
    <h2 class="my-0 text-[1.75rem] leading-[1.15]">{name}</h2>
    {hebrewName && (
      <span
        lang="he"
        dir="rtl"
        class="ml-auto font-heading text-[1.75rem] leading-[1.15] font-medium text-gray-500"
      >
        {hebrewName}
      </span>
    )}
  </div>
  {description && (
    <p class="my-0 text-base leading-[1.65]">
      {splitHebrew(description).map(({ text, hebrew }) =>
        hebrew ? (
          <span lang="he" dir="rtl">
            {text}
          </span>
        ) : (
          text
        ),
      )}
    </p>
  )}
  <ListenLinks {...Astro.props} look="icons" class="pt-1" />
</article>
