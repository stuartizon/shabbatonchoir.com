---
import type { CollectionEntry } from 'astro:content';
import IconLink from './IconLink.astro';

type Props = CollectionEntry<'albums'>['data'];

const { name, description, year, cover, spotify, apple, amazon } = Astro.props;
---

<div class="bg-white rounded-lg overflow-hidden w-80 mb-8">
  <div class="h-full w-full bg-gray-50 rounded-b-lg">
    <img src={cover.src} alt={name} class="w-full max-h-72" />
    <div class="p-4">
      <div class="flex items-center justify-between">
        <div class="font-semibold text-xs">{year}</div>
        <div class="flex -my-2 -mr-1">
          <IconLink
            href={spotify}
            label={`Listen to ${name} on Spotify`}
            name="spotify"
            class="px-1 py-[13px]"
          />
          <IconLink
            href={apple}
            label={`Listen to ${name} on Apple Music`}
            name="apple-music"
            class="px-1 py-[13px]"
          />
          <IconLink
            href={amazon}
            label={`Listen to ${name} on Amazon Music`}
            name="amazon"
            class="px-1 py-[13px]"
          />
        </div>
      </div>
      <h2 class="font-bold my-4">{name}</h2>
      <p class="text-sm my-2">{description}</p>
    </div>
  </div>
</div>
