---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

type Props = CollectionEntry<'albums'>['data'];

const { name, description, year, cover, spotify, apple, amazon } = Astro.props;
---

<div class="bg-white rounded-lg overflow-hidden w-80 mb-8">
  <div class="h-full w-full bg-gray-50 rounded-b-lg">
    <img src={cover.src} alt={name} class="w-full max-h-72" />
    <div class="p-4">
      <div class="flex items-center justify-between">
        <div class="font-semibold text-xs">{year}</div>
        <div class="flex gap-x-2">
          <a href={spotify} target="_blank" rel="noreferrer">
            <Icon class="text-gray-600" name="spotify" />
          </a>
          <a href={apple} target="_blank" rel="noreferrer">
            <Icon class="text-gray-600" name="apple-music" />
          </a>
          <a href={amazon} target="_blank" rel="noreferrer">
            <Icon class="text-gray-600" name="amazon" />
          </a>
        </div>
      </div>
      <h2 class="font-bold my-4">{name}</h2>
      <p class="text-sm my-2">{description}</p>
    </div>
  </div>
</div>
