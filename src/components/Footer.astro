---
import IconLink from './IconLink.astro';
import { SOCIAL_LINKS } from './social';
---

<footer class="flex bg-gray-100 justify-center gap-4 min-[375px]:gap-6 sm:gap-8 p-6">
  {SOCIAL_LINKS.map(({ service, name, href }) => (
    <IconLink
      href={href}
      label={`Shabbaton Choir on ${service}`}
      name={name}
      size="2x"
      class="-m-1.5 p-1.5"
      ringOffset="group-focus-visible:outline-offset-[6px]"
    />
  ))}
</footer>
