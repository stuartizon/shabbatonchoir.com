---
// Renders one of the site's icons (src/icons.ts) as inline SVG. Icons are
// 1em square and take the text colour, so size them with font size.
import { ICONS, type IconData, type IconName } from '../icons';

interface Props {
  name: IconName;
  size?: '2x';
  class?: string;
}

const { name, size, class: className } = Astro.props;
const { viewBox, paths }: IconData = ICONS[name];
---

<svg
  data-icon={name}
  aria-hidden="true"
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
  viewBox={viewBox}
  fill="currentColor"
  class:list={[
    'inline-block h-[1em] w-[1em] overflow-visible align-[-0.125em]',
    size === '2x' && 'text-[2em]',
    className,
  ]}
>
  {paths.map(({ d, evenodd }) => (
    <path
      d={d}
      fill-rule={evenodd ? 'evenodd' : undefined}
      clip-rule={evenodd ? 'evenodd' : undefined}
    />
  ))}
</svg>
