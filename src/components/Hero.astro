---
import { Picture } from 'astro:assets';
import { HERO_SIZES, HERO_WIDTHS, heroImage } from './hero';

interface Props {
  mode: 'mobile' | 'desktop';
}

const { mode } = Astro.props;
---

<div
  data-hero
  class:list={[
    'relative isolate w-screen',
    {
      'md:hidden h-40': mode === 'mobile',
      'hidden h-screen md:block': mode === 'desktop',
    },
  ]}
>
  <Picture
    src={heroImage}
    alt=""
    width={2000}
    widths={HERO_WIDTHS}
    sizes={HERO_SIZES}
    formats={['avif', 'webp']}
    quality="high"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-10 size-full object-cover object-center"
  />
  <div
    class="shade absolute inset-0 -z-10 mix-blend-screen"
    aria-hidden="true"
  ></div>
  <slot />
</div>

<style>
  /* Screened over the photo, this lightens its top more than its bottom. */
  .shade {
    background: linear-gradient(rgba(90, 90, 90, 1), rgba(0, 0, 0, 1));
  }
</style>
