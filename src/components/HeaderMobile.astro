---
import { faBars } from '@fortawesome/free-solid-svg-icons';
import Icon from './Icon.astro';
import Logo from './Logo.astro';
---

<header class="md:hidden">
  <div class="md:container md:px-10 pt-4 mx-auto md:flex md:justify-between md:items-center">
    <div class="flex items-center justify-between mx-4">
      <Logo />
      <div class="md:hidden text-primary-500 flex items-center">
        <div class="mx-2">MENU</div>
        <span data-menu-toggle class="contents"><Icon size="2x" class="text-primary-500" icon={faBars} /></span>
      </div>
    </div>
    <div class="bg-gradient-to-t from-gray-100 h-3"></div>
  </div>
</header>
