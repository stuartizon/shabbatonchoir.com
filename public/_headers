# Cloudflare Pages response headers.
#
# Keep every copy of the site except www.shabbatonchoir.com out of search
# results. The first rule covers the production deployment's own address
# (shabbatonchoir.pages.dev); the second covers branch aliases such as
# staging and PR previews, which Cloudflare also marks noindex itself.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:alias.:project.pages.dev/*
  X-Robots-Tag: noindex

# Custom domains for non-production builds. Cloudflare only adds noindex on
# pages.dev, so add a rule here for each one.
https://staging.shabbatonchoir.com/*
  X-Robots-Tag: noindex
